{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/tech",
      "destination": "/tech.html"
    },
    {
      "source": "/r",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "15 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 20
    }
  }
}
